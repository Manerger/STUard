# ---------------------------------------------------------------------------
# STUard secrets. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Discord (https://discord.com/developers/applications → your app) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# OAuth2 client of the same application. Used to confirm that the browser
# finishing verification belongs to the Discord user who ran /verify.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Register slash commands in the guild on startup (or run /setup sync later).
SYNC_COMMANDS=true

# --- Microsoft 365 sign-in (optional, see README → "Microsoft 365 sign-in") ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Web / SAML ---
# Public HTTPS origin used by STU's IdP and Discord redirects (no trailing slash).
PUBLIC_BASE_URL=https://verify.example.sk
WEB_HOST=0.0.0.0
WEB_PORT=8080
DISCORD_OAUTH_REQUIRED=true
# Only for local development against a test IdP on http://localhost.
DEV_ALLOW_HTTP=false
# true only behind a proxy that sets X-Forwarded-For (docker-compose.yml sets it for you).
# Cloudflare appends the real client IP last, which is the entry the rate limiter reads.
TRUST_FORWARDED_FOR=false
# Hostname for Caddy / docker compose (same host as PUBLIC_BASE_URL). Unused behind cloudflared.
PUBLIC_HOST=verify.example.sk
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install connector -> token.
# Give this service a tunnel of its own; sharing a token with another tunnel breaks both.
# Leave empty (and delete the cloudflared service) if you terminate HTTPS some other way.
CLOUDFLARE_TUNNEL_TOKEN=

# Random secret, 48+ bytes:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up separately from the database. Changing it breaks duplicate-account detection.
SUBJECT_HMAC_KEY=

# --- SMTP for email-code verification (only if email.enabled in config.yaml) ---
# Resend (used here): host smtp.resend.com, port 465, SSL, user "resend", password = a Resend API key
# (sending-only, no inbound), SMTP_FROM = any address on a domain verified in Resend (e.g. stuardbot@your.domain).
# Gmail also works: host smtp.gmail.com, port 587, STARTTLS, user = the address, password = an App Password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false
SMTP_SSL=true

# --- STU VPN for LDAP enrichment (only if email.ldap.enabled in config.yaml) ---
# Used by the "stuvpn" sidecar in docker-compose.yml, which opens an OpenVPN tunnel to STU (vpn.cvt.stuba.sk)
# and forwards ldap.stuba.sk:636 to the bot. Put the .ovpn profile at secrets/stu-vpn.ovpn (never commit it).
# Your STU/AIS login and password (the VPN prompts for auth-user-pass):
STU_VPN_USER=
STU_VPN_PASS=
# Real IP of ldap.stuba.sk (public A record; the sidecar reaches it through the tunnel).
STU_LDAP_IP=147.175.1.11

# Generated by scripts/gen_sp_keys.sh
SAML_SP_KEY_FILE=secrets/sp.key
SAML_SP_CERT_FILE=secrets/sp.crt
# Pinned copy of https://idp.stuba.sk/idp/shibboleth (scripts/fetch_idp_metadata.py)
SAML_IDP_METADATA_FILE=saml/idp_metadata.xml
SAML_IDP_ENTITY_ID=https://idp.stuba.sk/idp/shibboleth

# --- Runtime ---
DATABASE_PATH=data/stuard.sqlite3
CONFIG_PATH=config.yaml
LOG_LEVEL=INFO
