{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Access log without verification tokens, OAuth codes or cookies.
	log {
		output stdout
		format filter {
			request>uri query {
				delete t
				delete c
				delete code
				delete state
			}
			request>headers>Cookie delete
		}
	}

	reverse_proxy bot:8080
}
